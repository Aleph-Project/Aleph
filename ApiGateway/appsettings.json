{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Apigateway": {
    "Routes": {
      "Reviews": {
        "ClusterId": "Reviews",
        "Match": {
          "Path": "/api/v1/reviews/{**catchall}",
          "Methods": [ "GET", "POST", "PUT", "DELETE", "PATCH" ]
        }
      },
      "Profiles": {
        "ClusterId": "Profiles",
        "Match": {
          "Path": "/api/v1/profiles/{**catchall}",
          "Methods": [ "GET", "POST", "PUT", "DELETE", "PATCH" ]
        }
      },
      "Music": {
        "ClusterId": "Music",
        "Match": {
          "Path": "/api/v1/music/{**catchall}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        }
      },
      "Auth":{
        "ClusterId": "Auth",
        "Match": {
          "Path": "/api/v1/auth/{**catchall}",
          "Methods": [ "GET", "POST", "PUT", "DELETE" ]
        }
      },
      "Analytics": {
        "ClusterId": "Analytics",
        "Match": {
          "Path": "/api/v1/analytics/{**catchall}",
          "Methods": [ "GET", "POST" ]
        }
      }
    },
    "Clusters": {
      "Reviews": {
        "Destinations": {
          "ReviewsService": {
            "Address": "http://reviews-ms:3000/"
          }
        }
      },
      "Profiles": {
        "Destinations": {
          "ProfilesService": {
            "Address": "http://profile-load-balancer:80/"
          }
        }
      },
      "Music": {
        "Destinations": {
          "MusicService": {
            "Address": "http://music-load-balancer:80"
          }
        }
      },
      "Auth": {
        "Destinations": {
          "AuthService": {
            "Address": "http://auth-load-balancer:80/"
          }
        }
      },
      "Analytics": {
        "Destinations": {
          "AnalyticsService": {
            "Address": "http://analysis-ms:8000/"
          }
        }
      }
    }
  },
  "Services": {
    "Profiles": "http://profile-load-balancer:80",
    "Reviews": "http://reviews-ms:3000",
    "Auth": "http://auth-load-balancer:80"
  },
  "AllowedHosts": "*"
}
